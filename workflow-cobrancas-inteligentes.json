{
  "name": "n8n-cobrancas-inteligentes",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        500
      ]
    },
    {
      "parameters": {
        "resource": "sheet",
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "SUBSTITUIR_PELO_ID_DA_PLANILHA",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Faturas",
          "mode": "list"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Google Sheets - Ler Faturas",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        220,
        500
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "SUBSTITUIR",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-email-1",
              "leftValue": "={{ $json.email }}",
              "rightValue": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Filter - Email valido",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        440,
        500
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-cartao-1",
              "leftValue": "={{ $json.forma_pagamento }}",
              "rightValue": "cartao_automatico",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Filter - Sem pagamento automatico",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        660,
        500
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-vencida-1",
              "leftValue": "={{ $json.data_vencimento }}",
              "rightValue": "={{ $now }}",
              "operator": {
                "type": "dateTime",
                "operation": "before"
              }
            },
            {
              "id": "cond-vencida-2",
              "leftValue": "={{ $json.status_pagamento }}",
              "rightValue": "inadimplente",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Filter - Faturas vencidas",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        880,
        500
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "set-1",
              "name": "nome_cliente",
              "type": "string",
              "value": "={{ $json.nome }}"
            },
            {
              "id": "set-2",
              "name": "dias_atraso",
              "type": "number",
              "value": "={{ Math.floor((Date.now() - new Date($json.data_vencimento).getTime()) / 86400000) }}"
            },
            {
              "id": "set-3",
              "name": "valor_formatado",
              "type": "string",
              "value": "={{ $json.valor_fatura.toLocaleString('pt-BR', {style:'currency', currency:'BRL'}) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Set - Variaveis da mensagem",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1100,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "const html = `<p>Olá, ${$json.nome_cliente},</p><p>Identificamos uma fatura em aberto no valor de <strong>${$json.valor_formatado}</strong>, vencida há ${$json.dias_atraso} dia(s).</p><p>Por favor, regularize o pagamento o quanto antes.</p>`;\nreturn { ...$json, html_corpo: html };"
      },
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Code - Template HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        500
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=Fatura em aberto – {{ $json.nome_cliente }}",
        "message": "={{ $json.html_corpo }}",
        "options": {}
      },
      "id": "a1b2c3d4-0008-4000-8000-000000000008",
      "name": "Gmail - Enviar cobranca",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1540,
        500
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "SUBSTITUIR",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "resource": "sheet",
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "SUBSTITUIR_PELO_ID_DA_PLANILHA",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Faturas",
          "mode": "list"
        },
        "columnToMatchOn": "email",
        "valueToMatchOn": "={{ $json.email }}",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status_cobranca",
              "fieldValue": "enviado"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0009-4000-8000-000000000009",
      "name": "Google Sheets - Marcar enviado",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1760,
        500
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "SUBSTITUIR",
          "name": "Google Sheets account"
        }
      }
    }
  ],
  "pinData": {},
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Google Sheets - Ler Faturas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets - Ler Faturas": {
      "main": [
        [
          {
            "node": "Filter - Email valido",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter - Email valido": {
      "main": [
        [
          {
            "node": "Filter - Sem pagamento automatico",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter - Sem pagamento automatico": {
      "main": [
        [
          {
            "node": "Filter - Faturas vencidas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter - Faturas vencidas": {
      "main": [
        [
          {
            "node": "Set - Variaveis da mensagem",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set - Variaveis da mensagem": {
      "main": [
        [
          {
            "node": "Code - Template HTML",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code - Template HTML": {
      "main": [
        [
          {
            "node": "Gmail - Enviar cobranca",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gmail - Enviar cobranca": {
      "main": [
        [
          {
            "node": "Google Sheets - Marcar enviado",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
